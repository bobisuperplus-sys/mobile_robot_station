<mujoco model="urban_proving_ground">
  <compiler angle="radian" meshdir="../models/turtlebot3/meshes" autolimits="true"/>

  <option timestep="0.005" integrator="implicitfast" gravity="0 0 -9.81"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.3 0.3 0.3" specular="0.1 0.1 0.1"/>
    <rgba haze="0.2 0.3 0.4 1"/>
    <global azimuth="-135" elevation="-25"/>
  </visual>

  <asset>
    <!-- 天空盒与环境贴图 -->
    <texture type="skybox" builtin="gradient" rgb1="0.4 0.6 0.8" rgb2="0.1 0.15 0.25" width="512" height="512"/>
    <texture name="asphalt_tex" type="2d" builtin="checker" rgb1="0.15 0.15 0.16" rgb2="0.18 0.18 0.19" width="512" height="512" mark="cross" markrgb="0.3 0.3 0.3"/>
    <material name="asphalt_mat" texture="asphalt_tex" texrepeat="20 20" reflectance="0.05" roughness="0.8"/>

    <!-- 建筑与装饰材质 -->
    <material name="building_grey" rgba="0.65 0.68 0.72 1" reflectance="0.1"/>
    <material name="building_glass" rgba="0.25 0.45 0.65 1" reflectance="0.4"/>
    <material name="building_brick" rgba="0.75 0.42 0.32 1" reflectance="0.05"/>
    <material name="building_dark" rgba="0.25 0.28 0.32 1" reflectance="0.1"/>
    <material name="pillar_white" rgba="0.9 0.9 0.92 1" reflectance="0.2"/>
    <material name="curb_yellow" rgba="0.92 0.75 0.15 1" reflectance="0.1"/>
    <material name="grass_green" rgba="0.28 0.52 0.24 1" reflectance="0.05"/>
    <material name="obstacle_box" rgba="0.85 0.55 0.2 1" reflectance="0.1"/>
  </asset>

  <worldbody>
    <!-- 定向日光光源 -->
    <light pos="5 -5 18" dir="-0.3 0.3 -1" directional="true" diffuse="0.85 0.85 0.8" specular="0.3 0.3 0.3" castshadow="true"/>

    <!-- 全局高空透视监控相机 (Overview Cam) -->
    <camera name="overview_cam" pos="0 -15 12" xyaxes="1 0 0 0 0.64 0.77" fovy="65"/>

    <!-- 1. 地面基座 (26m x 26m 沥青测试场) -->
    <geom name="ground" type="plane" size="14 14 0.1" material="asphalt_mat" friction="1.2 0.005 0.0001"/>

    <!-- 2. 外围封闭建筑群围墙 (高 4.0m，彻底防止小车出界，为激光雷达提供远距离大平面约束) -->
    <geom name="wall_north" type="box" size="13 0.3 2.0" pos="0 13 2.0" material="building_dark"/>
    <geom name="wall_south" type="box" size="13 0.3 2.0" pos="0 -13 2.0" material="building_dark"/>
    <geom name="wall_east"  type="box" size="0.3 13 2.0" pos="13 0 2.0" material="building_dark"/>
    <geom name="wall_west"  type="box" size="0.3 13 2.0" pos="-13 0 2.0" material="building_dark"/>

    <!-- 3. 西北部：高层科技塔楼 A (高 6.5m，带有双层阶梯与外挑平台) -->
    <body name="building_A" pos="-7 7 0">
      <geom type="box" size="3.5 3.5 3.0" pos="0 0 3.0" material="building_grey"/>
      <geom type="box" size="2.5 2.5 1.5" pos="0 0 6.0" material="building_glass"/>
      <!-- 外凸裙楼与入口门廊，创造丰富垂直与水平角点 -->
      <geom type="box" size="1.2 0.3 1.2" pos="0 -3.6 1.2" material="building_dark"/>
    </body>

    <!-- 4. 东北部：现代商业综合体 B (高 4.5m，砖红色质感，凹凸窗套立面) -->
    <body name="building_B" pos="7 7 0">
      <geom type="box" size="3.8 2.8 2.25" pos="0 0 2.25" material="building_brick"/>
      <geom type="box" size="2.2 1.8 1.0" pos="0.5 0 4.25" material="building_grey"/>
      <!-- 街道转角侧边防撞柱 -->
      <geom type="cylinder" size="0.15 0.6" pos="-3.2 -2.2 0.6" material="pillar_white"/>
      <geom type="cylinder" size="0.15 0.6" pos="-3.2 -1.2 0.6" material="pillar_white"/>
    </body>

    <!-- 5. 东南部：L 型院落与走廊街道 C (高 3.5m，形成狭窄巷道 Alleyway) -->
    <body name="building_C" pos="7 -7 0">
      <geom type="box" size="3.8 1.6 1.75" pos="0 2.0 1.75" material="building_dark"/>
      <geom type="box" size="1.6 2.2 1.75" pos="-2.2 -1.8 1.75" material="building_grey"/>
    </body>

    <!-- 6. 西南部：立体研发独栋 D + 缓坡台阶 Ramp (测试 IMU 俯仰角与坡道 3D 点云) -->
    <body name="building_D" pos="-7 -7 0">
      <geom type="box" size="3.2 3.2 2.0" pos="0 0 2.0" material="building_glass"/>
      <!-- 缓坡坡道 (倾角约 12 度，长 2.5m) -->
      <geom type="box" size="0.9 1.4 0.2" pos="3.2 0 0.2" euler="0.2 0 0" material="building_grey"/>
    </body>

    <!-- 7. 中央环岛与绿化景观 (构建天然环形道路闭环 Loop Closure) -->
    <body name="central_plaza" pos="0 0 0">
      <!-- 环岛中心圆台 -->
      <geom type="cylinder" size="2.0 0.2" pos="0 0 0.2" material="grass_green"/>
      <!-- 环岛中央雕塑立柱 (极佳的激光角点中心参考物) -->
      <geom type="cylinder" size="0.35 1.8" pos="0 0 1.8" material="pillar_white"/>
      <geom type="box" size="0.6 0.6 0.4" pos="0 0 3.8" material="curb_yellow"/>
    </body>

    <!-- 8. 立柱走廊 (Colonnade of Pillars：测试多线激光雷达角点与圆柱特征提取) -->
    <body name="colonnade" pos="0 0 0">
      <!-- 沿西侧主干道排列的一组标准化圆柱 -->
      <geom type="cylinder" size="0.22 1.4" pos="-2.8 4.0 1.4" material="pillar_white"/>
      <geom type="cylinder" size="0.22 1.4" pos="-2.8 6.0 1.4" material="pillar_white"/>
      <geom type="cylinder" size="0.22 1.4" pos="-2.8 8.0 1.4" material="pillar_white"/>

      <!-- 沿东侧主干道排列的立柱 -->
      <geom type="cylinder" size="0.22 1.4" pos="2.8 4.0 1.4" material="pillar_white"/>
      <geom type="cylinder" size="0.22 1.4" pos="2.8 6.0 1.4" material="pillar_white"/>
      <geom type="cylinder" size="0.22 1.4" pos="2.8 8.0 1.4" material="pillar_white"/>
    </body>

    <!-- 9. 街道局部几何障碍体 (用于测试局部避障规划与点云遮挡推算) -->
    <body name="street_obstacles" pos="0 0 0">
      <!-- 南侧道路上的几何箱子 -->
      <geom type="box" size="0.4 0.4 0.35" pos="1.8 -4.5 0.35" material="obstacle_box"/>
      <geom type="box" size="0.3 0.5 0.25" pos="-1.5 -8.5 0.25" material="obstacle_box"/>
      <!-- 北侧道路立柱附近的障碍圆柱桶 (移至立柱走廊内侧以保证高台通道宽敞) -->
      <geom type="cylinder" size="0.25 0.4" pos="2.0 5.5 0.4" material="curb_yellow"/>
    </body>

    <!-- 10. 北侧立体观景台与上坡坡道 (测试 2.5D 高程感知、越障爬坡与高台停驻) -->
    <body name="elevated_ramp_platform" pos="0 0 0">
      <!-- 零台阶平顺入地缓坡 (宽 2.0m，坡度仅 3.4 度/0.06rad，南端深沉入地消灭突唇，北侧无缝平顺衔接高台 Z=0.12m) -->
      <geom name="access_ramp" type="box" size="1.0 1.30 0.04" pos="0 3.7 0.002" euler="0.060 0 0" material="asphalt_mat" friction="1.5 0.005 0.0001"/>
      <!-- 高台基座 (标高 Z=0.12m，尺寸 2.2m x 2.0m，中心 Y=6.0，Z_pos=0.06) -->
      <geom name="platform_deck" type="box" size="1.1 1.0 0.06" pos="0 6.0 0.06" material="building_grey" friction="1.5 0.005 0.0001"/>
      <!-- 高台西侧防护警示边沿 -->
      <geom type="box" size="0.05 1.0 0.03" pos="-1.1 6.0 0.15" material="curb_yellow"/>
      <!-- 高台东侧防护警示边沿 -->
      <geom type="box" size="0.05 1.0 0.03" pos="1.1 6.0 0.15" material="curb_yellow"/>
      <!-- 高台北侧防护警示边沿 -->
      <geom type="box" size="1.1 0.05 0.03" pos="0 7.05 0.15" material="curb_yellow"/>
    </body>
  </worldbody>

  <!-- 引入 TurtleBot3 Burger 移动机器人完整模型 -->
  <include file="../models/turtlebot3/turtlebot3_burger.xml"/>
</mujoco>
